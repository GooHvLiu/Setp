{
  "name": "setp-backend",
  "version": "0.8.7",
  "description": "Setp - Express + TypeScript + Prisma backend template",
  "private": true,
  "main": "dist/app.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooHvLiu/Setp.git"
  },
  "homepage": "https://github.com/GooHvLiu/Setp#readme",
  "bugs": {
    "url": "https://github.com/GooHvLiu/Setp/issues"
  },
  "scripts": {
    "tsoa": "tsoa spec-and-routes",
    "init": "tsx ./src/middleware/dotenvInit.middleware.ts",
    "db:sync-schema": "node scripts/db/sync-schema.cjs",
    "db:generate": "npm run db:sync-schema && prisma generate",
    "db:deploy": "node scripts/db/ensure-dirs.cjs && npm run db:sync-schema && prisma migrate deploy && tsx src/db/helpMigrations.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync": "npm run db:generate && npm run db:deploy && npm run db:seed",
    "db:prepare": "npm run db:generate && npm run db:deploy && node scripts/db/ensure-seed.cjs",
    "db:drift": "node scripts/db/check-drift.cjs",
    "db:rebuild": "npm run db:sync-schema && node scripts/rebuild-db.cjs && npm run db:generate && npm run db:deploy && npm run db:seed",
    "help:index": "tsx src/modules/help/helpIndex.ts",
    "config:seal": "tsx src/db/sealSensitiveConfig.ts",
    "dev": "npm run tsoa && npm run init && npm run db:prepare && nodemon --exec tsx app.ts",
    "start": "npm run init && npm run db:prepare && npm run build && npm run start:prod",
    "build": "npm run clean:dist && npm run tsoa && tsc -p tsconfig.build.json && node scripts/rewrite-aliases.cjs",
    "start:prod": "node dist/app.js",
    "clean:dist": "node scripts/clean-dist.cjs",
    "verify:response": "tsx test/verify-response-contract.ts",
    "verify:rbac": "tsx test/verify-rbac.ts",
    "verify:ops": "tsx test/verify-ops.ts",
    "pretest:unit": "npm run tsoa",
    "test:unit": "vitest run",
    "pretest:coverage": "npm run tsoa",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test": "npm run verify:response && npm run verify:rbac && npm run verify:ops && npm run test:unit",
    "test:ci": "npm run tsoa && npm run verify:response && npm run verify:rbac && npm run verify:ops && npm run test:coverage",
    "test:api": "node test/api-full-test.cjs",
    "contract:export": "tsx scripts/docs/export-contract.ts",
    "contract:check": "tsx scripts/docs/check-contract.ts",
    "check:response": "tsx scripts/docs/check-response-language.ts",
    "check:lockfile": "tsx scripts/docs/check-lockfile-registry.ts",
    "gen:module": "node scripts/new-module.mjs",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src app.ts test routes vitest.config.mts eslint.config.mjs",
    "format": "prettier --write \"app.ts\" \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"vitest.config.mts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"app.ts\" \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"vitest.config.mts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig.json\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:response && npm run check:lockfile",
    "kill:PID": "powershell -Command \"$port = 3000; $procId = (Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue | Select-Object -First 1).OwningProcess; if ($procId) { taskkill /F /PID $procId } else { Write-Host 'Port 3000 is not in use' }\""
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "tsoa",
    "rbac",
    "mysql",
    "sqlite",
    "swagger"
  ],
  "author": "Setp Maintainers",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3",
    "glob": "14.0.6",
    "minimatch": "11.0.8",
    "ts-deepmerge": "8.0.0",
    "effect": "3.22.5"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "dotenv-expand": "^13.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "imapflow": "^2.11.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "svg-captcha": "^1.4.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.14.0",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "_moduleAliases": {
    "@root": "./",
    "@routes": "./routes",
    "@src": "./src"
  }
}
